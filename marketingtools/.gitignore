# ===================================
# 환경 변수 (절대 커밋 금지!)
# ===================================
.env
.env.local
.env.*.local
*.key
*.pem

# ===================================
# OS 파일
# ===================================
.DS_Store
Thumbs.db
desktop.ini

# ===================================
# 에디터 설정
# ===================================
.vscode/
.idea/
*.swp
*.swo

# ===================================
# 결과물 (대용량 / 자동 생성)
# ===================================
output/*.pptx
output/*.pdf
output/**/*.png
output/**/*.jpg
output/**/*.jpeg
output/**/*.webp

# 단, 결과물 폴더의 .gitkeep과 README는 유지
!output/**/.gitkeep
!output/**/README.md

# ===================================
# Node / Python 의존성
# ===================================
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# ===================================
# 로그
# ===================================
*.log
logs/

# ===================================
# OMC 내부 상태 (자동 관리)
# ===================================
.omc/state/
.omc/logs/
