# ===================================
# 환경 변수 예시 파일
# ===================================
# 이 파일을 복사해서 ".env" 로 이름 변경 후
# 실제 API 키를 입력하세요.
#
# ⚠️ .env 파일은 절대 GitHub에 커밋하지 마세요!
# ===================================

# Google AI Studio - Nano Banana (Gemini Image)
# 발급: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Buffer API - 소셜 미디어 자동 포스팅
# 발급: https://developers.buffer.com/
BUFFER_API_KEY=your_buffer_api_key_here

# OpenAI (선택, 필요한 경우)
# OPENAI_API_KEY=your_openai_api_key_here
