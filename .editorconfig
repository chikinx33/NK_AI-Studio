root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
charset = utf-8-bom
trim_trailing_whitespace = false

[*.html]
charset = utf-8-bom

[*.js]
charset = utf-8-bom

[*.ts]
charset = utf-8-bom

[*.css]
charset = utf-8-bom

[*.ps1]
end_of_line = crlf
